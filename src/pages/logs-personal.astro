---
import Layout from "../layouts/Layout.astro";
import getPersonalLogs from "../lib/server/logs_personal_server";

let logsPersonalsData = [];
try {
  logsPersonalsData = await getPersonalLogs();
} catch (error) {
  console.error("Error fetching personal logs:", error);
  logsPersonalsData = [{ id: 0, title: "Error", content: "Failed to fetch personal logs", date: new Date().toISOString(), color: async () => "#ff0000" }];
}
---

<Layout>
  <main class="max-w-4xl mx-auto">
    <div class="hover:z-30">
      <h1 class="font-['DotGothic16'] text-3xl text-pink-100 mb-8">
        <span
          class="bg-pink-500/10 text-pink-500 border border-pink-500/30 px-2 py-1 rounded text-neon font-['Fira_Code'] tracking-widest m-4"
        >
          CMD
        </span>
        ls ./Comentarios_personales
      </h1>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-6">
      {
        logsPersonalsData.map(async (log) => {
          const color = await log.color();
          return (
           <article
  class:list={[
    "bg-[#1f0a1c]/80 border border-pink-900 rounded-lg overflow-hidden font-mono text-sm reveal",
    `delay-${(log.id % 3) + 1}`,
    "transition-all duration-300 hover:-translate-y-1",
    "hover:shadow-[0_0_20px_var(--log-color)]",
    log.id % 2 === 0 ? "md:col-span-2" : "",
  ]}
  style={`--log-color: ${color};`}
>
  <!-- barra tipo terminal, reutilizando el patrón de TerminalHeader -->
  <div class="bg-[#2a102a] border-b border-pink-900/50 px-3 py-2 flex items-center gap-2">
    <div class="flex gap-1.5">
      <div class="w-2.5 h-2.5 rounded-full bg-red-500/50" />
      <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/50" />
      <div class="w-2.5 h-2.5 rounded-full" style={`background-color: ${color}`} />
    </div>
    <span class="text-pink-300/80 truncate">~/logs/{log.title.toLowerCase().replace(/\s+/g, "_")}.log</span>
  </div>
  <div class="p-4 space-y-1">
    <p class="text-neon text-pink-300">
      <span class="text-green-400">$</span> cat {log.title}.log
    </p>
    <p class="text-neon tracking-wide">"{log.content}"</p>
    <p class="text-pink-500/70 text-xs mt-2">[{log.date}] · proceso finalizado ✓</p>
  </div>
</article>
          );
        })
      }
    </div>

    <a
      href="/"
      class="inline-block mt-8 text-neon font-['Fira_Code'] hover:text-pink-400"
    >
      ← Volver al inicio
    </a>
  </main>
</Layout>
