---
import Scanline from "src/components/Scanline.astro";
import TerminalHeader from "src/components/TerminalHeader.astro";
import Layout from "src/layouts/Layout.astro";
---

<Layout title="404 | Página no encontrada">
	<Scanline />
	<main class="relative z-10 grid min-h-[calc(100dvh-4rem)] place-items-center">
		<section
			aria-labelledby="error-title"
			class="terminal-window w-full max-w-3xl overflow-hidden rounded-lg bg-[#1f0a1c]"
		>
			<TerminalHeader />
			<div class="px-6 py-12 sm:px-12 sm:py-16">
				<p class="font-['Fira_Code'] text-sm text-pink-300/70">ERROR 404 <span class="text-pink-100/40">/</span> RUTA NO ENCONTRADA</p>
				<h1 id="error-title" class="mt-5 font-['DotGothic16'] text-7xl leading-none text-pink-300 text-neon sm:text-8xl">
					404<span class="text-pink-100">.</span>
				</h1>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-pink-50 sm:text-xl">
					Parece que esta página se perdió entre líneas de código.
				</p>
				<p class="mt-2 max-w-xl text-sm leading-relaxed text-pink-100/60 sm:text-base">
					La dirección puede haber cambiado o ya no estar disponible.
				</p>
				<a
					href="/"
					class="mt-8 inline-flex min-h-12 items-center gap-3 border border-pink-400/60 bg-pink-500/10 px-5 py-3 font-['Fira_Code'] text-sm text-pink-100 transition-colors hover:border-pink-300 hover:bg-pink-500/20 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pink-300"
				>
					<span aria-hidden="true">&larr;</span> Volver al inicio
				</a>
			</div>
		</section>
	</main>
</Layout>
