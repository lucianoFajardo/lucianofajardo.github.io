---
import proyectType from "../lib/models/proyect-post";
---

<section
  class="mt-20 mb-10 text-center border-t border-pink-900/50 pt-10 font-['Fira_Code']"
>
  <h2
    class="font-bold mb-8 flex items-center gap-3 font-['DotGothic16'] text-2xl text-pink-100"
  >
    <span
      class="bg-pink-500/10 text-pink-500 border border-pink-500/30 px-2 py-1 rounded text-sm text-neon font-['Fira_Code'] tracking-widest"
      >CMD</span
    > ls ./Proyectos_Realizados
  </h2>

  {
    proyectType.map((i) => (
      <div class="group w-full overflow-hidden rounded border border-pink-900/60 bg-[#1f0a1c]/80 transition-all duration-300 hover:-translate-y-1 hover:border-pink-500/50 hover:shadow-[0_0_20px_rgba(236,72,153,0.15)] lg:flex" onclick={`window.open('${i.urlWeb}', '_blank')`}>
        <div
          class="relative h-48 flex-none overflow-hidden bg-cover bg-center lg:h-auto lg:w-48"
          style={`background-image: url('${i.imgUrl}')`}
          title={i.title}
        >
          <div class="absolute inset-0 bg-linear-to-t from-[#1f0a1c]/70 to-transparent"></div>
        </div>

        <div class="flex flex-col justify-between p-5 leading-normal lg:flex-1">
          <div class="mb-8">
            <p class="mb-4 flex items-center gap-2 text-xs tracking-widest text-pink-400/80">
              <span class="h-2 w-2 rounded-full bg-pink-500 shadow-[0_0_8px_rgba(236,72,153,0.7)]" />
              Personal Project :)
            </p>

            <h3 class="mb-3 font-['DotGothic16'] text-xl font-bold text-pink-100">
              {i.title}
            </h3>

            <p class="text-sm leading-relaxed text-pink-200/70">
              {i.description}
            </p>
          </div>

          <div class="flex items-center gap-3 border-t border-pink-900/50 pt-4">
            <img
              class="h-10 w-10 rounded-full border border-pink-500/40 object-cover"
              src={i.imgAuth}
              alt={`Avatar of ${i.author}`}
            />
            <div class="text-sm">
              <p class="leading-none text-pink-100">{i.author}</p>
              <p class="mt-1 text-xs text-pink-400/70">{i.date}</p>
            </div>
          </div>
        </div>
      </div>
    ))
  }
</section>
